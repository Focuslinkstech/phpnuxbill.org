{
  // Cloudflare Workers: serve the built static site (npm run build writes it to dist/).
  // Without this file `npx wrangler deploy` guesses the framework and runs `astro add cloudflare`,
  // which installs an adapter and rebuilds the site as a server project.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phpnuxbill-org",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
