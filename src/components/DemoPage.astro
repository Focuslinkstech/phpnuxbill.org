---
import Base from '../layouts/Base.astro';
import { pages } from '../i18n/pages';
import { localePath, type Lang } from '../i18n';
import { DEMO_LOGINS } from '../data/demo';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const P = pages[lang].demoPage;

const cards = DEMO_LOGINS.map((d) => ({
  ...d,
  title: d.id === 'admin' ? P.adminTitle : P.customerTitle,
  text: d.id === 'admin' ? P.adminText : P.customerText,
  open: d.id === 'admin' ? P.adminOpen : P.customerOpen,
  rows: [[P.address, d.url, 'link'], [P.username, d.username, 'copy'], [P.password, d.password, 'copy']].filter(([, v]) => v) as [string, string, 'link' | 'copy'][],
}));
for (const d of DEMO_LOGINS) {
  if (!d.username || !d.password) console.warn(`[demo] the ${d.id} login in src/data/demo.ts has no ${!d.username ? 'username' : 'password'}, so it is not shown`);
}
---
<Base title={P.title} description={P.description}>
  <div class="mx-auto max-w-6xl px-4 py-12 lg:py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{P.title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">{P.intro}</p>

    <div class="mt-10 grid gap-5 sm:mt-12 sm:gap-6 lg:grid-cols-2">
      {cards.map((c) => (
        <section class="flex min-w-0 flex-col rounded-2xl border bg-card p-5 sm:p-8" aria-labelledby={`demo-${c.id}`}>
          <h2 id={`demo-${c.id}`} class="text-2xl font-semibold tracking-tight">{c.title}</h2>
          <p class="mt-3 leading-relaxed text-muted-foreground">{c.text}</p>
          <dl class="mt-6 space-y-3">
            {c.rows.map(([label, value, kind]) => (
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-lg border bg-background px-3 py-3 sm:px-4">
                <dt class="w-full text-xs text-muted-foreground sm:w-24 sm:flex-none sm:text-sm">{label}</dt>
                <dd class="min-w-0 flex-1 break-all font-mono text-sm sm:truncate sm:break-normal" dir="ltr">{value}</dd>
                {kind === 'link' && (
                  <a href={value} target="_blank" rel="noopener noreferrer" aria-label={`${P.newTab}: ${c.title}`} title={P.newTab} class="flex h-9 w-9 flex-none items-center justify-center rounded-md border hover:bg-accent sm:h-auto sm:w-auto sm:px-2.5 sm:py-1.5">
                    <svg class="h-4 w-4 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
                  </a>
                )}
                {kind === 'copy' && (
                  <button type="button" data-copy={value} data-done={P.copied} aria-label={`${P.copy}: ${c.title}, ${label}`} class="demo-copy h-9 flex-none rounded-md border px-3.5 text-xs font-medium hover:bg-accent sm:h-auto sm:px-3 sm:py-1">{P.copy}</button>
                )}
              </div>
            ))}
          </dl>
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="mt-8 block w-full rounded-full bg-brand-fill px-6 py-3 text-center text-sm font-semibold text-white hover:brightness-110 sm:inline-block sm:w-auto sm:self-start">{c.open}</a>
        </section>
      ))}
    </div>

    <p id="demo-copy-status" role="status" aria-live="polite" data-manual={P.copyManual} class="mt-4 min-h-6 text-sm text-muted-foreground"></p>

    <section class="mt-6 rounded-2xl bg-muted/60 p-5 sm:p-8" aria-labelledby="demo-notice">
      <h2 id="demo-notice" class="text-2xl font-semibold tracking-tight">{P.noticeTitle}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{P.noticeText}</p>
      <a href={localePath(lang, '/docs/getting-started/installation/')} class="mt-6 block w-full rounded-full border border-foreground/20 px-6 py-3 text-center text-sm font-semibold hover:bg-accent sm:inline-block sm:w-auto">{P.install}</a>
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.demo-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // clipboard blocked (an http page, an old browser): select the text and say how to copy it by hand
        const value = btn.parentElement?.querySelector('dd');
        if (value) { const r = document.createRange(); r.selectNodeContents(value); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
        const status = document.getElementById('demo-copy-status');
        if (status) {
          status.textContent = status.dataset.manual ?? '';
          setTimeout(() => { status.textContent = ''; }, 8000);
        }
        return;
      }
      const label = btn.textContent;
      btn.textContent = btn.dataset.done ?? label;
      setTimeout(() => { btn.textContent = label; }, 1500);
    });
  });
</script>
