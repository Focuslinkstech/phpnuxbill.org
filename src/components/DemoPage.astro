---
import Base from '../layouts/Base.astro';
import { pages } from '../i18n/pages';
import { localePath, type Lang } from '../i18n';
import { DEMO_LOGINS } from '../data/demo';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const P = pages[lang].demoPage;

const cards = DEMO_LOGINS.map((d) => ({
  ...d,
  title: d.id === 'admin' ? P.adminTitle : P.customerTitle,
  text: d.id === 'admin' ? P.adminText : P.customerText,
  open: d.id === 'admin' ? P.adminOpen : P.customerOpen,
  rows: [[P.address, d.url, false], [P.username, d.username, true], [P.password, d.password, true]].filter(([, v]) => v) as [string, string, boolean][],
}));
for (const d of DEMO_LOGINS) {
  if (!d.username || !d.password) console.warn(`[demo] the ${d.id} login in src/data/demo.ts has no ${!d.username ? 'username' : 'password'}, so it is not shown`);
}
---
<Base title={P.title} description={P.description}>
  <div class="mx-auto max-w-6xl px-4 py-12 lg:py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{P.title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">{P.intro}</p>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {cards.map((c) => (
        <section class="flex flex-col rounded-2xl border bg-card p-6 sm:p-8" aria-labelledby={`demo-${c.id}`}>
          <h2 id={`demo-${c.id}`} class="text-2xl font-semibold tracking-tight">{c.title}</h2>
          <p class="mt-3 leading-relaxed text-muted-foreground">{c.text}</p>
          <dl class="mt-6 space-y-3">
            {c.rows.map(([label, value, copyable]) => (
              <div class="flex items-center gap-3 rounded-lg border bg-background px-4 py-3">
                <dt class="w-24 flex-none text-sm text-muted-foreground">{label}</dt>
                <dd class="min-w-0 flex-1 truncate font-mono text-sm" dir="ltr">{value}</dd>
                {copyable && (
                  <button type="button" data-copy={value} data-done={P.copied} class="demo-copy flex-none rounded-md border px-3 py-1 text-xs font-medium hover:bg-accent">{P.copy}</button>
                )}
              </div>
            ))}
          </dl>
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block self-start rounded-full bg-brand-fill px-6 py-3 text-sm font-semibold text-white hover:brightness-110">{c.open}</a>
        </section>
      ))}
    </div>

    <section class="mt-10 rounded-2xl bg-muted/60 p-6 sm:p-8" aria-labelledby="demo-notice">
      <h2 id="demo-notice" class="text-2xl font-semibold tracking-tight">{P.noticeTitle}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{P.noticeText}</p>
      <a href={localePath(lang, '/docs/getting-started/installation/')} class="mt-6 inline-block rounded-full border border-foreground/20 px-6 py-3 text-sm font-semibold hover:bg-accent">{P.install}</a>
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.demo-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // clipboard blocked (an http page, an old browser): select the text so Ctrl+C works
        const value = btn.parentElement?.querySelector('dd');
        if (value) { const r = document.createRange(); r.selectNodeContents(value); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
        return;
      }
      const label = btn.textContent;
      btn.textContent = btn.dataset.done ?? label;
      setTimeout(() => { btn.textContent = label; }, 1500);
    });
  });
</script>
