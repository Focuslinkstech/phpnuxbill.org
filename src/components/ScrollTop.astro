---
import { DEFAULT_LANG, ui, type Lang } from '../i18n';
const lang = (Astro.currentLocale ?? DEFAULT_LANG) as Lang;
const label = ui[lang].backToTop;
---
<button id="scroll-top" type="button" aria-label={label} title={label} tabindex="-1" aria-hidden="true"
  class="scroll-top fixed bottom-5 end-5 z-40 grid h-12 w-12 place-items-center rounded-full bg-card text-foreground shadow-lg transition hover:bg-accent">
  <!-- the ring is the page progress: it fills as you read down the page -->
  <svg class="absolute inset-0 -rotate-90" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22" fill="none" style="stroke: var(--border)" stroke-width="3" />
    <circle id="scroll-ring" cx="24" cy="24" r="22" fill="none" style="stroke: var(--brand)" stroke-width="3" stroke-linecap="round" stroke-dasharray="138.23" stroke-dashoffset="138.23" />
  </svg>
  <svg class="relative" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6l6 6"/></svg>
</button>
<script>
  // Shown once the page has been scrolled about a screen and a half; hidden from keyboard and screen readers until then.
  // The ring around it shows how far down the page you are.
  const btn = document.getElementById('scroll-top');
  const ring = document.getElementById('scroll-ring');
  if (btn && ring) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const label = btn.getAttribute('aria-label') || '';
    const length = 2 * Math.PI * 22;
    let shown = false;
    let frame = 0;
    const update = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      ring.style.strokeDashoffset = String(length * (1 - progress));
      btn.title = `${label} (${Math.round(progress * 100)}%)`;
      const show = window.scrollY > Math.max(600, window.innerHeight * 1.5);
      if (show === shown) return;
      shown = show;
      btn.classList.toggle('is-visible', show);
      btn.tabIndex = show ? 0 : -1;
      btn.setAttribute('aria-hidden', String(!show));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduced.matches ? 'instant' : 'smooth' }));
    update();
  }
</script>
