---
import { SITE, COMMUNITY } from '../site';
import { DEFAULT_LANG, ui, localePath, type Lang } from '../i18n';
import { pages } from '../i18n/pages';

const lang = (Astro.currentLocale ?? DEFAULT_LANG) as Lang;
const t = ui[lang].footer;
const supportLabel = pages[lang].support.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Grouped so a phone shows short lists side by side, not one long wrapping row. Site paths get the language prefix.
const groups: [string, [string, string][]][] = [
  [t.learn, [
    [t.documentation, localePath(lang, '/docs/')],
    [t.install, localePath(lang, '/docs/getting-started/installation/')],
    [t.build, localePath(lang, '/docs/extending/overview/')],
    [t.extensions, localePath(lang, '/extensions/')],
    [t.demo, COMMUNITY.demo],
  ]],
  [t.community, [
    [supportLabel, localePath(lang, '/support/')],
    [t.forum, COMMUNITY.forum],
    [t.telegram, COMMUNITY.telegram],
    [t.facebook, COMMUNITY.facebook],
    [t.discussions, COMMUNITY.discussions],
  ]],
  [t.project, [
    [t.github, SITE.repo],
    [t.starter, SITE.starter],
    [t.releaseNotes, localePath(lang, '/changelog/')],
  ]],
];
---
<footer class="border-t">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="col-span-full sm:col-span-1">
        <p class="font-display flex items-center gap-2 text-lg font-semibold"><img src={`${base}/favicon.png`} alt="" width="24" height="24" class="h-6 w-6" />PHPNuxBill</p>
        <p class="mt-2 max-w-xs text-sm text-muted-foreground">{t.tagline}</p>
      </div>
      <div class="col-span-full grid grid-cols-2 gap-8 sm:col-span-3 sm:grid-cols-3">
        {groups.map(([title, links], i) => (
          <nav aria-label={title} class:list={[i === 0 && 'col-span-2 sm:col-span-1']}>
            <p class="text-sm font-semibold">{title}</p>
            <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
              {links.map(([label, url]) => (
                <li><a class="inline-block py-0.5 hover:text-foreground" href={url} rel={url.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <p class="mt-10 border-t pt-6 text-sm text-muted-foreground">
      {t.copyright.replace('{year}', String(new Date().getFullYear()))}
      <a class="ms-2 underline underline-offset-2 hover:text-foreground" href={`${SITE.repo}/blob/main/LICENSE`} rel="noopener">{t.license}</a>
    </p>
  </div>
</footer>
