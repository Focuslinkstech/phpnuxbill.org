---
import Base from '../layouts/Base.astro';
import HeroMock from './HeroMock.astro';
import ExtensionSlider from './ExtensionSlider.astro';
import Contributors from './Contributors.astro';
import { loadRepository, loadContributors, loadRelease } from '../data/community';
import { COMMUNITY, SITE } from '../site';
import { localePath, type Lang } from '../i18n';
import { landing } from '../i18n/landing';
import { pages } from '../i18n/pages';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const L = landing[lang];
const P = pages[lang];
const release = await loadRelease();

// Fetched when the site is built (see src/data/community.ts), so these lists stay current without a database or a client request.
const repo = await loadRepository();
const people = await loadContributors();
const authors = [...new Set([...repo.plugins, ...repo.gateways, ...repo.devices].map((x) => x.author).filter(Boolean))].sort((a, b) => a.localeCompare(b));

---
<Base>
  <!-- hero -->
  <section class="relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-14 lg:pb-24 lg:pt-20">
      <div class="rise mx-auto max-w-3xl text-center">
        <h1 class="text-[2.6rem] font-semibold leading-[1.04] tracking-tight sm:text-6xl">{L.hero.title}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{L.hero.text}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={localePath(lang, '/docs/getting-started/installation/')} class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white shadow-sm hover:brightness-110">{L.hero.install}</a>
          <a href={COMMUNITY.demo} rel="noopener" class="rounded-full border border-foreground/20 px-6 py-3 text-sm font-semibold hover:bg-accent">{P.demo.hero}</a>
          <a href="#day" class="rounded-full px-4 py-3 text-sm font-semibold text-muted-foreground hover:text-foreground">{L.hero.how}</a>
        </div>
        <p class="mt-5 text-sm text-muted-foreground">{L.hero.note}</p>
        <p class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm">
          <a href={release?.url ?? `${SITE.repo}/releases/latest`} rel="noopener" class="font-semibold text-brand hover:underline">{P.download.label}{release ? ` ${release.tag}` : ''}</a>
          <a href={localePath(lang, '/changelog/')} class="text-muted-foreground hover:text-foreground">{P.download.notes}</a>
        </p>
      </div>
      <div class="rise mt-12 lg:mt-16" style="animation-delay: 120ms"><HeroMock /></div>
    </div>
  </section>

  <!-- a customer's day: a real sequence, so it is numbered -->
  <section id="day" class="border-y bg-muted/50">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">{L.day.title}</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {L.day.steps.map(([title, text], i) => (
          <li class="relative md:pe-6">
            <span class="font-display grid h-10 w-10 place-items-center rounded-full bg-foreground text-base font-semibold text-background">{i + 1}</span>
            {i < L.day.steps.length - 1 && <span class="absolute start-12 end-2 top-5 hidden h-px bg-border md:block"></span>}
            <h3 class="mt-5 text-xl font-semibold">{title}</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- what you manage: a ruled list, not a grid of cards -->
  <section id="features" class="mx-auto max-w-6xl px-4 py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{L.manage.title}</h2>
        <p class="mt-4 max-w-md leading-relaxed text-muted-foreground">{L.manage.text}</p>
        <a href={localePath(lang, '/docs/getting-started/introduction/')} class="mt-6 inline-block font-semibold text-brand hover:underline">{L.manage.link}</a>
      </div>
      <dl class="divide-y border-y">
        {L.manage.items.map(([term, text]) => (
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="font-display text-lg font-semibold">{term}</dt>
            <dd class="leading-relaxed text-muted-foreground">{text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- extend -->
  <section id="extend" class="bg-foreground text-background">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 lg:grid-cols-2 lg:items-center lg:py-24">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{L.extend.title}</h2>
        <p class="mt-4 max-w-lg leading-relaxed opacity-80">{L.extend.text}</p>
        <a href={localePath(lang, '/docs/extending/overview/')} class="mt-6 inline-block rounded-full bg-sun px-6 py-3 text-sm font-semibold text-[#0b2b3a] hover:brightness-105">{L.extend.button}</a>
      </div>
      <pre dir="ltr" class="overflow-x-auto rounded-2xl border border-white/15 bg-black/25 p-5 text-start text-sm leading-relaxed"><code>{`// system/plugin/hello.php
register_menu('Hello', true, 'hello', 'AFTER_DASHBOARD',
              '', '', 'success', ['SuperAdmin', 'Admin']);

function hello()
{
    global $ui;
    _admin();
    $ui->assign('_title', Lang::T('Hello'));
    $ui->display('hello.tpl');
}`}</code></pre>
    </div>
  </section>

  <!-- extensions already written, from the official repository -->
  <section id="repository" class="mx-auto max-w-6xl px-4 py-16 lg:py-24">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">{L.repository.title}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      {L.repository.text.replace('{plugins}', String(repo.plugins.length)).replace('{gateways}', String(repo.gateways.length)).replace('{devices}', String(repo.devices.length))}
    </p>
    <div class="mt-12 space-y-14">
      <ExtensionSlider id="plugin-list" title={L.repository.plugins[0]} intro={L.repository.plugins[1]} items={repo.plugins} />
      <ExtensionSlider id="gateway-list" title={L.repository.gateways[0]} intro={L.repository.gateways[1]} items={repo.gateways} />
    </div>
    <p class="mt-10 text-center">
      <a href={localePath(lang, '/extensions/')} class="inline-flex items-center rounded-md border px-5 py-2.5 font-medium hover:bg-accent">{L.repository.all.replace('{n}', String(repo.plugins.length + repo.gateways.length + repo.devices.length))}</a>
    </p>
  </section>

  <!-- requirements -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-5xl">{L.needs.title}</h2>
      <div>
        <p class="leading-relaxed text-muted-foreground">{L.needs.text}</p>
        <ul class="mt-4 space-y-2">
          {L.needs.items.map((n) => (
            <li class="flex gap-3"><svg class="mt-1 h-4 w-4 flex-none text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg><span dir="auto">{n}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 lg:grid-cols-[1fr_1.6fr] lg:py-24">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{P.faq.title}</h2>
        <p class="mt-4 max-w-md leading-relaxed text-muted-foreground">{P.faq.text}</p>
      </div>
      <div class="divide-y border-y">
        {P.faq.items.map(([q, a]) => (
          <details class="faq group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold">
              {q}
              <svg class="faq-icon h-4 w-4 flex-none transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6l6-6"/></svg>
            </summary>
            <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- credits -->
  <section id="credits" class="border-t">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">{L.credits.title}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{L.credits.text.replace('{count}', String(people.length))}</p>
      <div class="mt-8"><Contributors people={people} authors={authors} /></div>
      <a href="https://github.com/hotspotbilling/phpnuxbill/graphs/contributors" rel="noopener" class="mt-8 inline-block font-semibold text-brand hover:underline">{L.credits.link}</a>
    </div>
  </section>

  <!-- friendly close -->
  <section class="border-t bg-muted/50">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center lg:py-20">
      <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">{L.close.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-muted-foreground">{L.close.text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={localePath(lang, '/docs/getting-started/installation/')} class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white hover:brightness-110">{L.close.install}</a>
        <a href={COMMUNITY.forum} rel="noopener" class="rounded-full border border-foreground/20 px-6 py-3 text-sm font-semibold hover:bg-accent">{L.close.forum}</a>
        <a href={COMMUNITY.telegram} rel="noopener" class="rounded-full border border-foreground/20 px-6 py-3 text-sm font-semibold hover:bg-accent">{L.close.telegram}</a>
        <a href={COMMUNITY.facebook} rel="noopener" class="rounded-full border border-foreground/20 px-6 py-3 text-sm font-semibold hover:bg-accent">{L.close.facebook}</a>
        <a href={COMMUNITY.discussions} rel="noopener" class="rounded-full border border-foreground/20 px-6 py-3 text-sm font-semibold hover:bg-accent">{L.close.ask}</a>
      </div>
      <p class="mt-8 text-sm"><a href={localePath(lang, '/support/')} class="font-semibold text-brand hover:underline">{P.support.learnMore}</a></p>
    </div>
  </section>
</Base>
