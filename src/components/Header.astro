---
import { SITE, COMMUNITY } from '../site';
import { LANGUAGES, DEFAULT_LANG, ui, localePath, stripLocale, type Lang } from '../i18n';
const lang = (Astro.currentLocale ?? DEFAULT_LANG) as Lang;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = stripLocale(Astro.url.pathname);
const current = LANGUAGES.find((l) => l.code === lang)!;
---
<header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4">
    <a href={localePath(lang, '/')} class="flex items-center gap-2 font-semibold">
      <img src={`${base}/favicon.png`} alt="" width="28" height="28" class="h-7 w-7" />
      <span>PHPNuxBill</span>
    </a>
    <nav class="ms-2 hidden items-center gap-5 text-sm text-muted-foreground sm:flex">
      <a href={localePath(lang, '/docs/')} class="hover:text-foreground">{t.nav.docs}</a>
      <a href={`${localePath(lang, '/')}#features`} class="hover:text-foreground">{t.nav.features}</a>
      <a href={`${localePath(lang, '/')}#extend`} class="hover:text-foreground">{t.nav.extend}</a>
      <a href={localePath(lang, '/extensions/')} class="hover:text-foreground">{t.footer.extensions}</a>
      <a href={COMMUNITY.forum} rel="noopener" class="hover:text-foreground">{t.nav.forum}</a>
    </nav>
    <div class="ms-auto flex items-center gap-2">
      <a href={localePath(lang, '/demo/')} class="rounded-full bg-brand-fill px-3.5 py-1.5 text-sm font-semibold text-white hover:brightness-110">{t.nav.demo}</a>
      <a href={SITE.repo} class="hidden rounded-md px-3 py-1.5 text-sm text-muted-foreground hover:bg-accent hover:text-foreground sm:block" rel="noopener">{t.nav.github}</a>

      <details class="lang relative">
        <summary aria-label={t.language} title={t.language} class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-md border px-2.5 text-sm hover:bg-accent">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
          <span class="uppercase">{current.code}</span>
        </summary>
        <ul class="absolute end-0 z-50 mt-2 w-44 rounded-lg border bg-card p-1 shadow-lg">
          {LANGUAGES.map((l) => (
            <li>
              <a href={localePath(l.code, here)} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}
                class:list={['block rounded-md px-3 py-2 text-sm hover:bg-accent', l.code === lang && 'bg-accent font-medium']}>{l.name}</a>
            </li>
          ))}
        </ul>
      </details>

      <button id="theme-toggle" type="button" aria-label="Theme: system" title="Theme: system" class="theme-toggle grid h-9 w-9 place-items-center rounded-md border hover:bg-accent">
        <svg class="i-system" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
        <svg class="i-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>
<script is:inline define:vars={{ themeLabel: t.theme }}>
  // system -> light -> dark -> system. The icon and label show the current mode.
  (function () {
    var btn = document.getElementById('theme-toggle');
    var next = { system: 'light', light: 'dark', dark: 'system' };
    function label() { var m = window.__themeMode(); btn.setAttribute('aria-label', themeLabel + ': ' + m); btn.title = themeLabel + ': ' + m; }
    label();
    btn.addEventListener('click', function () { window.__setThemeMode(next[window.__themeMode()]); label(); });
    // the language menu closes when you click elsewhere or press Escape
    var menu = document.querySelector('details.lang');
    document.addEventListener('click', function (e) { if (menu && !menu.contains(e.target)) menu.removeAttribute('open'); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && menu) menu.removeAttribute('open'); });
  })();
</script>
