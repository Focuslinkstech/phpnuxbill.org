---
import DocPage from '../../../components/DocPage.astro';
import { resolveDocs } from '../../../i18n/docs';
import { OTHER_LANGS } from '../../../i18n';
export async function getStaticPaths() {
  const out = [];
  for (const lang of OTHER_LANGS) {
    for (const doc of await resolveDocs(lang)) out.push({ params: { lang, slug: doc.slug }, props: { doc } });
  }
  return out;
}
const { lang } = Astro.params;
const { doc } = Astro.props;
---
<DocPage lang={lang as any} doc={doc} />
