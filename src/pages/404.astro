---
import '../styles/global.css';
import { LANGUAGES, localePath, type Lang } from '../i18n';
import { pages } from '../i18n/pages';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · PHPNuxBill</title>
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem('theme');
          var dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="grid min-h-screen place-items-center px-4">
    {LANGUAGES.map((l) => {
      const P = pages[l.code as Lang].notFound;
      return (
        <main data-lang={l.code} lang={l.code} dir={l.dir} hidden={l.code !== 'en'} class="max-w-md text-center">
          <img src={`${base}/favicon.png`} alt="" width="48" height="48" class="mx-auto mb-6 h-12 w-12" />
          <p class="font-display text-6xl font-semibold text-brand">404</p>
          <h1 class="mt-3 text-2xl font-semibold">{P.title}</h1>
          <p class="mt-3 leading-relaxed text-muted-foreground">{P.text}</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={localePath(l.code as Lang, '/')} class="rounded-full bg-brand-fill px-5 py-2.5 text-sm font-semibold text-white hover:brightness-110">{P.home}</a>
            <a href={localePath(l.code as Lang, '/docs/')} class="rounded-full border border-foreground/20 px-5 py-2.5 text-sm font-semibold hover:bg-accent">{P.docs}</a>
          </div>
        </main>
      );
    })}
    <script is:inline define:vars={{ codes: LANGUAGES.map((l) => l.code), base }}>
      // show the block for the language in the address (/es/...), English otherwise
      var path = location.pathname.slice(base.length);
      var first = path.split('/')[1];
      var lang = codes.indexOf(first) > -1 ? first : 'en';
      document.querySelectorAll('main[data-lang]').forEach(function (m) { m.hidden = m.dataset.lang !== lang; });
      document.documentElement.lang = lang;
      document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
    </script>
  </body>
</html>
