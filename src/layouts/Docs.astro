---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { DEFAULT_LANG, ui, type Lang } from '../i18n';
const lang = (Astro.currentLocale ?? DEFAULT_LANG) as Lang;
const t = ui[lang];
const { title, description, section, current, headings = [], fallback = false, prev, next, editUrl } = Astro.props;
const toc = headings.filter((h: { depth: number }) => h.depth === 2 || h.depth === 3);
---
<Base title={title} description={description}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-8 lg:grid-cols-[14rem_minmax(0,1fr)] xl:grid-cols-[14rem_minmax(0,1fr)_13rem]">
    <aside class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto" data-pagefind-ignore>
      <details class="lg:hidden rounded-md border p-3">
        <summary class="cursor-pointer text-sm font-medium">{t.menu}</summary>
        <div class="mt-4"><Sidebar current={current} /></div>
      </details>
      <div class="hidden lg:block"><Sidebar current={current} /></div>
    </aside>
    <article data-pagefind-body={fallback ? undefined : ''} data-pagefind-ignore={fallback ? '' : undefined}>
      <p class="text-sm text-muted-foreground">{section}</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight" data-pagefind-meta="title">{title}</h1>
      {description && <p class="mt-2 text-lg text-muted-foreground">{description}</p>}
      {fallback && <p class="mt-6 rounded-md border border-sun/50 bg-sun/10 px-4 py-3 text-sm" lang={lang}>{t.notTranslated}</p>}
      {/* the page body is in the language of its file; English fallback pages say so */}
      <div class="prose dark:prose-invert mt-8" lang={fallback ? 'en' : lang} dir={fallback ? 'ltr' : undefined}><slot /></div>
      <footer class="mt-12 border-t pt-6" data-pagefind-ignore>
        {editUrl && <a href={editUrl} rel="noopener" class="text-sm text-muted-foreground hover:text-foreground">{t.docsNav.edit}</a>}
        {(prev || next) && (
          <nav aria-label="Pagination" class="mt-6 grid gap-4 sm:grid-cols-2">
            {prev ? (
              <a href={prev.href} rel="prev" class="rounded-lg border p-4 hover:bg-accent">
                <span class="block text-sm text-muted-foreground">{t.docsNav.previous}</span>
                <span class="mt-1 block font-semibold">{prev.title}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a href={next.href} rel="next" class="rounded-lg border p-4 text-end hover:bg-accent sm:col-start-2">
                <span class="block text-sm text-muted-foreground">{t.docsNav.next}</span>
                <span class="mt-1 block font-semibold">{next.title}</span>
              </a>
            ) : null}
          </nav>
        )}
      </footer>
    </article>
    {toc.length > 0 && (
      <aside class="hidden xl:sticky xl:top-20 xl:block xl:max-h-[calc(100vh-6rem)] xl:self-start xl:overflow-y-auto" data-pagefind-ignore>
        <p class="mb-2 text-xs font-semibold tracking-wide text-muted-foreground">{t.onThisPage}</p>
        <ul class="space-y-1.5 text-sm">
          {toc.map((h: { depth: number; slug: string; text: string }) => (
            <li class={h.depth === 3 ? 'ps-3' : ''}><a href={`#${h.slug}`} class="text-muted-foreground hover:text-foreground">{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>
